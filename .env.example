# ─────────────────────────────────────────────────────────────
# Aerospace RWA — local configuration
# Copy to .env.local (apps) or .env (services) and never commit keys.
# Demo mode is the default. Nothing in demo mode settles value.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet
NEXT_PUBLIC_API_URL=

# API
PORT=4000
HOST=127.0.0.1
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004
DEMO_MODE=true
API_KEY=replace-with-a-long-random-value
DATABASE_URL=postgres://aerospace:aerospace@localhost:5432/aerospace_rwa
DEMO_SEED=true
LOG_LEVEL=info

# Soroban / Stellar
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_INDEXER_START_LEDGER=1
STELLAR_INDEXER_POLL_MS=5000
STELLAR_INDEXER_CURSOR_FILE=.data/indexer-cursor.json

# Contract addresses are populated by scripts/deploy-contracts.sh.

# Stellar testnet payment (challenge mission). Never commit a real secret key.
STELLAR_PAYMENT_SECRET_KEY=
STELLAR_PAYMENT_DESTINATION=
STELLAR_PAYMENT_AMOUNT=1
STELLAR_PAYMENT_MEMO=SHIP-S97KF8
ASSET_REGISTRY_CONTRACT_ID=
COMPLIANCE_CONTRACT_ID=
RWA_TOKEN_WASM_HASH=
INVESTMENT_CONTRACT_ID=
ESCROW_CONTRACT_ID=
REVENUE_DISTRIBUTION_CONTRACT_ID=
LEASING_CONTRACT_ID=
MARKETPLACE_CONTRACT_ID=
GOVERNANCE_CONTRACT_ID=

# Document verification
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/
DOCUMENT_HMAC_SECRET=replace-with-a-long-random-value

# Oracle adapters
VALUATION_ORACLE_URL=
VALUATION_ORACLE_HMAC_SECRET=

# Notifications
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
